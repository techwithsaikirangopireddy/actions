<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>


    <!-- ====================================================== -->
    <!-- PROJECT INFORMATION -->
    <!-- ====================================================== -->

    <groupId>com.example</groupId>

    <artifactId>hello-mule</artifactId>

    <version>1.0.1</version>

    <packaging>mule-application</packaging>

    <name>hello-mule</name>

    <description>
        A simple Mule 4 REST API for learning.
    </description>


    <!-- ====================================================== -->
    <!-- MULESOFT REPOSITORY -->
    <!-- ====================================================== -->

    <repositories>

        <repository>

            <id>mulesoft-releases</id>

            <name>MuleSoft Releases Repository</name>

            <url>
                https://repository.mulesoft.org/releases/
            </url>

        </repository>

    </repositories>


    <pluginRepositories>

        <pluginRepository>

            <id>mulesoft-releases</id>

            <name>MuleSoft Releases Repository</name>

            <url>
                https://repository.mulesoft.org/releases/
            </url>

        </pluginRepository>

    </pluginRepositories>


    <!-- ====================================================== -->
    <!-- PROPERTIES -->
    <!-- ====================================================== -->

    <properties>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <mule.runtime.version>
            4.12.2
        </mule.runtime.version>

        <mule.maven.plugin.version>
            4.5.3
        </mule.maven.plugin.version>

        <mule.http.connector.version>
            1.11.0
        </mule.http.connector.version>

        <java.version>
            17
        </java.version>

    </properties>


    <!-- ====================================================== -->
    <!-- DEPENDENCIES -->
    <!-- ====================================================== -->

    <dependencies>

        <dependency>

            <groupId>
                org.mule.connectors
            </groupId>

            <artifactId>
                mule-http-connector
            </artifactId>

            <version>
                ${mule.http.connector.version}
            </version>

            <classifier>
                mule-plugin
            </classifier>

        </dependency>

    </dependencies>


    <!-- ====================================================== -->
    <!-- BUILD -->
    <!-- ====================================================== -->

    <build>

        <plugins>

            <plugin>

                <groupId>
                    org.mule.tools.maven
                </groupId>

                <artifactId>
                    mule-maven-plugin
                </artifactId>

                <version>
                    ${mule.maven.plugin.version}
                </version>

                <extensions>
                    true
                </extensions>

                <configuration>

                    <runtimeVersion>
                        ${mule.runtime.version}
                    </runtimeVersion>

                </configuration>

            </plugin>

        </plugins>

    </build>


    <!-- ====================================================== -->
    <!-- CLOUDHUB 2.0 DEPLOYMENT -->
    <!-- ====================================================== -->

    <profiles>

        <profile>

            <id>
                cloudhub2-deploy
            </id>


            <!-- Activate when -DmuleDeploy is used -->

            <activation>

                <property>

                    <name>
                        muleDeploy
                    </name>

                </property>

            </activation>


            <build>

                <plugins>

                    <plugin>

                        <groupId>
                            org.mule.tools.maven
                        </groupId>

                        <artifactId>
                            mule-maven-plugin
                        </artifactId>

                        <version>
                            ${mule.maven.plugin.version}
                        </version>


                        <configuration>

                            <cloudhub2Deployment>


                                <!-- ================================================= -->
                                <!-- ANYPOINT PLATFORM -->
                                <!-- ================================================= -->

                                <uri>
                                    ${anypoint.uri}
                                </uri>


                                <!-- ================================================= -->
                                <!-- PROVIDER -->
                                <!-- ================================================= -->

                                <provider>
                                    MC
                                </provider>


                                <!-- ================================================= -->
                                <!-- BUSINESS GROUP -->
                                <!-- ================================================= -->

                                <businessGroupId>
                                    ${anypoint.businessGroupId}
                                </businessGroupId>


                                <!-- ================================================= -->
                                <!-- ENVIRONMENT -->
                                <!-- ================================================= -->

                                <environment>
                                    ${anypoint.environment}
                                </environment>


                                <!-- ================================================= -->
                                <!-- CLOUDHUB 2.0 TARGET -->
                                <!-- ================================================= -->

                                <target>
                                    ${anypoint.target}
                                </target>


                                <!-- ================================================= -->
                                <!-- MULE RUNTIME -->
                                <!-- ================================================= -->

                                <muleVersion>
                                    ${mule.runtime.version}
                                </muleVersion>


                                <!-- ================================================= -->
                                <!-- APPLICATION NAME -->
                                <!-- ================================================= -->

                                <applicationName>
                                    ${anypoint.applicationName}
                                </applicationName>


                                <!-- ================================================= -->
                                <!-- REPLICAS -->
                                <!-- ================================================= -->

                                <replicas>
                                    ${anypoint.replicas}
                                </replicas>


                                <!-- ================================================= -->
                                <!-- VCORES -->
                                <!-- ================================================= -->

                                <vCores>
                                    ${anypoint.vCores}
                                </vCores>


                                <!-- ================================================= -->
                                <!-- CONNECTED APP AUTHENTICATION -->
                                <!-- ================================================= -->

                                <connectedAppClientId>
                                    ${env.ANYPOINT_CLIENT_ID}
                                </connectedAppClientId>

                                <connectedAppClientSecret>
                                    ${env.ANYPOINT_CLIENT_SECRET}
                                </connectedAppClientSecret>

                                <connectedAppGrantType>
                                    client_credentials
                                </connectedAppGrantType>


                            </cloudhub2Deployment>

                        </configuration>

                    </plugin>

                </plugins>

            </build>

        </profile>

    </profiles>

</project>