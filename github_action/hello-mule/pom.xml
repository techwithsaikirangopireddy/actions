<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>


    <!-- ====================================================== -->
    <!-- PROJECT INFORMATION -->
    <!-- ====================================================== -->

    <!-- Exchange / CloudHub 2.0 require the Anypoint organization ID as groupId -->
    <groupId>c33b559a-6e86-4aea-8f57-9b28faeb2881</groupId>

    <artifactId>hello-mule</artifactId>

    <version>1.0.1</version>

    <packaging>mule-application</packaging>

    <name>hello-mule</name>

    <description>
        A simple Mule 4 REST API for learning.
    </description>


    <!-- ====================================================== -->
    <!-- MULESOFT REPOSITORY -->
    <!-- ====================================================== -->

    <repositories>

        <repository>

            <id>mulesoft-releases</id>

            <name>MuleSoft Releases Repository</name>

            <url>
                https://repository.mulesoft.org/releases/
            </url>

        </repository>

    </repositories>


    <pluginRepositories>

        <pluginRepository>

            <id>mulesoft-releases</id>

            <name>MuleSoft Releases Repository</name>

            <url>
                https://repository.mulesoft.org/releases/
            </url>

        </pluginRepository>

    </pluginRepositories>


    <!-- ====================================================== -->
    <!-- EXCHANGE DISTRIBUTION MANAGEMENT -->
    <!-- ====================================================== -->

    <distributionManagement>
        <repository>
            <id>Exchange</id>
            <name>Anypoint Exchange</name>
            <url>
                https://maven.anypoint.mulesoft.com/api/v3/organizations/c33b559a-6e86-4aea-8f57-9b28faeb2881/maven
            </url>
            <layout>default</layout>
        </repository>
    </distributionManagement>


    <!-- ====================================================== -->
    <!-- PROPERTIES -->
    <!-- ====================================================== -->

    <properties>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <mule.runtime.version>
            4.7.0
        </mule.runtime.version>

        <mule.maven.plugin.version>
            4.3.0
        </mule.maven.plugin.version>

        <mule.http.connector.version>
            1.8.0
        </mule.http.connector.version>

        <java.version>
            17
        </java.version>

    </properties>


    <!-- ====================================================== -->
    <!-- DEPENDENCIES -->
    <!-- ====================================================== -->

    <dependencies>

        <dependency>

            <groupId>
                org.mule.connectors
            </groupId>

            <artifactId>
                mule-http-connector
            </artifactId>

            <version>
                ${mule.http.connector.version}
            </version>

            <classifier>
                mule-plugin
            </classifier>

        </dependency>

    </dependencies>


    <!-- ====================================================== -->
    <!-- BUILD -->
    <!-- ====================================================== -->

    <build>

        <plugins>

            <plugin>

                <groupId>
                    org.mule.tools.maven
                </groupId>

                <artifactId>
                    mule-maven-plugin
                </artifactId>

                <version>
                    ${mule.maven.plugin.version}
                </version>

                <extensions>
                    true
                </extensions>

                <configuration>

                    <runtimeVersion>
                        ${mule.runtime.version}
                    </runtimeVersion>

                </configuration>

            </plugin>

            <!-- mule-application packaging attaches a classifier jar, not a
                 Maven "main" artifact. Install/deploy plugin 3.x then fails
                 with "did not assign a file to the build artifact". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>2.5.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>2.8.2</version>
            </plugin>

        </plugins>

    </build>


    <!-- ====================================================== -->
    <!-- CLOUDHUB 2.0 DEPLOYMENT -->
    <!-- ====================================================== -->

    <profiles>

        <profile>

            <id>
                cloudhub2-deploy
            </id>


            <!-- Activate when -DmuleDeploy is used -->

            <activation>

                <property>

                    <name>
                        muleDeploy
                    </name>

                </property>

            </activation>


            <build>

                <plugins>

                    <plugin>

                        <groupId>
                            org.mule.tools.maven
                        </groupId>

                        <artifactId>
                            mule-maven-plugin
                        </artifactId>

                        <version>
                            ${mule.maven.plugin.version}
                        </version>


                        <configuration>

                            <cloudhub2Deployment>


                                <!-- ================================================= -->
                                <!-- ANYPOINT PLATFORM -->
                                <!-- ================================================= -->

                                <uri>
                                    ${anypoint.uri}
                                </uri>


                                <!-- ================================================= -->
                                <!-- PROVIDER -->
                                <!-- ================================================= -->

                                <provider>
                                    MC
                                </provider>


                                <!-- ================================================= -->
                                <!-- BUSINESS GROUP -->
                                <!-- ================================================= -->

                                <businessGroupId>
                                    ${anypoint.businessGroupId}
                                </businessGroupId>


                                <!-- ================================================= -->
                                <!-- ENVIRONMENT -->
                                <!-- ================================================= -->

                                <environment>
                                    ${anypoint.environment}
                                </environment>


                                <!-- ================================================= -->
                                <!-- CLOUDHUB 2.0 TARGET REGION -->
                                <!-- ================================================= -->

                                <target>
                                    ${anypoint.target}
                                </target>


                                <!-- ================================================= -->
                                <!-- MULE RUNTIME -->
                                <!-- ================================================= -->

                                <muleVersion>
                                    ${mule.runtime.version}
                                </muleVersion>

                                <releaseChannel>
                                    LTS
                                </releaseChannel>

                                <javaVersion>
                                    17
                                </javaVersion>


                                <!-- ================================================= -->
                                <!-- APPLICATION NAME -->
                                <!-- ================================================= -->

                                <applicationName>
                                    ${anypoint.applicationName}
                                </applicationName>


                                <!-- ================================================= -->
                                <!-- REPLICAS -->
                                <!-- ================================================= -->

                                <replicas>
                                    ${anypoint.replicas}
                                </replicas>


                                <!-- ================================================= -->
                                <!-- VCORES -->
                                <!-- ================================================= -->

                                <vCores>
                                    ${anypoint.vCores}
                                </vCores>


                                <!-- ================================================= -->
                                <!-- CONNECTED APP AUTHENTICATION -->
                                <!-- ================================================= -->

                                <connectedAppClientId>
                                    ${env.ANYPOINT_CLIENT_ID}
                                </connectedAppClientId>

                                <connectedAppClientSecret>
                                    ${env.ANYPOINT_CLIENT_SECRET}
                                </connectedAppClientSecret>

                                <connectedAppGrantType>
                                    client_credentials
                                </connectedAppGrantType>


                            </cloudhub2Deployment>

                        </configuration>

                    </plugin>

                </plugins>

            </build>

        </profile>

    </profiles>

</project>